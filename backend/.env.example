PORT=8080
DB_DRIVER=file
# 生产环境请使用强随机值
JWT_SECRET=

# 从 LiveKit Cloud 项目获取，只填写在后端 .env 中
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 可选。Cloud Webhook 使用的签名密钥与房间 API 不同时填写两项。
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=

# 私有 S3 兼容桶，S3_ENDPOINT 为空时使用 AWS 区域端点
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# 经学校核准后填写。未填写时禁用启用录制。
RECORDING_POLICY_VERSION=
RECORDING_NOTICE=
RECORDING_RETENTION_DAYS=

# 学院负责人账号的数字 ID，逗号分隔。播放、下载、保留/删除分别授权。
RECORDING_COLLEGE_VIEW_IDS=
RECORDING_DOWNLOAD_IDS=
RECORDING_MANAGE_IDS=

# 四阶段。先由学校核准告知、处理方及数据区域。空配置时不开启 AI。
INTERVIEW_AI_POLICY_VERSION=
INTERVIEW_AI_NOTICE=
INTERVIEW_STT_URL=
INTERVIEW_STT_MODEL=Systran/faster-whisper-large-v3
INTERVIEW_STT_API_KEY=
INTERVIEW_FFMPEG=ffmpeg
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
INTERVIEW_AI_COLLEGE_VIEW_IDS=
